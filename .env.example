# Optional: any OpenAI-compatible Chat Completions endpoint.
# Leave LLM_API_KEY empty to run in retrieval-only mode (no paid API needed).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# bm25 (default, zero extra deps) or embedding (needs sentence-transformers)
RAG_RETRIEVER=bm25
RAG_DOCS_DIR=data/docs
RAG_MAX_UPLOAD_MB=10
